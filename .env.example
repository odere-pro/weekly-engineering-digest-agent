# Copy to .env (chmod 600). Secrets live here only; they are never logged.

# Ollama endpoint. In Docker on macOS use http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Optional delivery secrets
SMTP_PASSWORD=
SLACK_WEBHOOK_URL=
# Optional: higher GitHub rate limits for release feeds
GITHUB_TOKEN=
