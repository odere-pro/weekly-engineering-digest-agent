# Copy to .env (chmod 600). Secrets live here only; they are never logged.

# Ollama endpoint. Leave OLLAMA_URL unset unless your setup is one of these:
#   Native (no Docker): http://localhost:11434, which is also the default.
#   Docker on a Mac:    http://host.docker.internal:11434 (the Ollama app on the host).
#   Docker on Linux:    leave it unset: Compose then uses its own Ollama, http://ollama:11434.
# Never set localhost for Docker: inside the container it is the container itself, and a value here
# overrides the Compose default.
# OLLAMA_URL=http://host.docker.internal:11434
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Optional delivery secrets
SMTP_PASSWORD=
SLACK_WEBHOOK_URL=
# Optional: higher GitHub rate limits for release feeds
GITHUB_TOKEN=
