{
  "name": "eng-digest",
  "version": "0.0.0",
  "description": "Local-first agent that writes a weekly digest of the AI and platform engineering releases that matter.",
  "license": "MIT",
  "author": "Oleksandr Derechei",
  "type": "module",
  "bin": {
    "digest": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "digest": "tsx src/cli/index.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "eval:record": "tsx evals/recordWeeks.ts"
  },
  "dependencies": {
    "@extractus/feed-extractor": "^8.0.3",
    "@inquirer/prompts": "^8.7.3",
    "@mastra/core": "1.78.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "commander": "^15.0.0",
    "croner": "^10.0.1",
    "nodemailer": "^10.1.2",
    "ollama": "^0.6.4",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
